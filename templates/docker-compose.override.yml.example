services:
  backend:
    build:
      context: ./storage-api
      dockerfile: Dockerfile
      target: development
    environment:
      - NODE_ENV=development
    volumes:
      - ./storage-api:/app
      - /app/node_modules
    command: npm run dev

  frontend:
    build:
      context: ./storage-app
      dockerfile: Dockerfile
      target: development
    volumes:
      - ./storage-app:/app
      - /app/node_modules
    command: npm run dev -- --host
